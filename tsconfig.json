{
    "compilerOptions": {
      "target": "es2021",
      "module": "commonjs",
      "jsx": "react-jsx",
      "noImplicitAny": true,
      "removeComments": true,
      "preserveConstEnums": true,
      "sourceMap": true,
      "lib": ["es2020", "DOM"],
      "moduleResolution": "node"
    },
    "include": ["src/**/*"],
}